% !TEX TS-program xelatex
% !TEX encoding = UTF-8 Unicode
% -*- coding: UTF-8; -*-
% vim: set fenc=utf-8

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%  FileName: tcode.sty
%%  Author:   Timozer
%%  E-mail:   zhenyuwang94@gmail.com
%%
%%  Modified: 2026/09/18
%%    代码环境改为「可降级」：
%%      · 默认用 fancyvrb，不依赖任何外部程序，任何机器都能编译（无语法高亮）；
%%      · 需要语法高亮时写 \usepackage[minted]{tcode}，此时要求本机有
%%        Python + pygments + latexminted，且 xelatex 必须加 -shell-escape。
%%    原版无条件加载 minted，一旦外部程序缺失就会在日志里刷一片错误。
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NeedsTeXFormat{LaTeX2e}[1994/06/01]
\ProvidesPackage{tcode}[2026/09/18 v0.7 Source Code Environment]

\RequirePackage{xcolor}
\RequirePackage{xifthen}
\RequirePackage{etoolbox}

\newif\ifcug@tcode@minted
\DeclareOption{minted}{\cug@tcode@mintedtrue}
\DeclareOption{nominted}{\cug@tcode@mintedfalse}
\ExecuteOptions{nominted}
\ProcessOptions\relax

\definecolor{mygray}{rgb}{0.85, 0.85, 0.85}

\ifcug@tcode@minted

    \RequirePackage[newfloat=true, cachedir=./_minted-cache, langlinenos=true]{minted}

    \setminted{%
        baselinestretch=1,
        tabsize=4,
        autogobble,
        texcl,
        mathescape,
        frame=single,
        framerule=0pt,
        bgcolor=mygray,
        numbersep=2pt,
        xleftmargin=12pt,
        fontsize=\small,
        fontfamily=tt,
        linenos,
        numbers=left,
        stepnumberfromfirst,
        stepnumber=1,
        numberblanklines,
        breaklines,
        breakanywhere,
    }
    \setmintedinline{autogobble, breakanywhere, breaklines, linenos=false,
        fontsize=\small, fontfamily=tt, bgcolor={}}

    \newcommand{\tcodeinline}[2]{\mintinline{#1}|#2|}

\else

    % fvextra = fancyvrb 的扩展，它才提供 breaklines（长行自动折行）。
    % 只用 fancyvrb 的话，超过版心的代码行会直接顶出页边 ——
    % 实测 demo.tex 中的长示例行溢出 142 磅（约 5 cm）。
    \RequirePackage{fvextra}

    \PackageWarningNoLine{tcode}{%
        代码环境已降级为 fvextra（无语法高亮）。\MessageBreak
        如需高亮：安装 Python 与 pygments/latexminted 后，\MessageBreak
        把 \string\usepackage{tcode} 改成 \string\usepackage[minted]{tcode}，\MessageBreak
        并给 xelatex 加上 -shell-escape 参数%
    }

    % 吃掉原 minted 的接口，使正文无需改动
    \newcommand{\setminted}[1][]{}
    \newcommand{\setmintedinline}[1][]{}
    \newcommand{\tcodeinline}[2]{\texttt{\detokenize{#2}}}
    \NewDocumentEnvironment{minted}{o m}{%
        \VerbatimEnvironment
        \begin{Verbatim}[breaklines=true, breakanywhere=true]%
    }{%
        \end{Verbatim}%
    }

\fi

\endinput
